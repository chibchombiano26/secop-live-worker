{
  "name": "secop-cpu-ocr",
  "main": "index.ts",
  "compatibility_date": "2026-10-15",
  "workers_dev": false,
  "preview_urls": false,
  "containers": [
    {
      "class_name": "CpuOcrContainer",
      "image": "./container/Dockerfile",
      "instance_type": "standard-2",
      "max_instances": 1,
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "OCR_CONTAINER", "class_name": "CpuOcrContainer" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CpuOcrContainer"] }],
}
